<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.mortbay.sailing</groupId>
    <artifactId>unmarkable</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <scm>
        <url>https://github.com/gregw/unmarkable</url>
        <connection>scm:git:https://github.com/gregw/unmarkable.git</connection>
        <developerConnection>scm:git:git@github.com:gregw/unmarkable.git</developerConnection>
    </scm>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <jackson.version>2.21.1</jackson.version>
        <jetty.version>12.1.12</jetty.version>
        <junit.version>5.13.4</junit.version>
        <hamcrest.version>3.0</hamcrest.version>
        <unmarkable-data>data</unmarkable-data>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <version>${jetty.version}</version>
        </dependency>
        <!--
            The login, and the ONE outbound call this server can make: an OpenID Connect
            discovery at start-up and a token exchange per sign-in. Nothing else here talks
            out, and an HTTP client for any other purpose is still the regression the
            architecture exists to prevent.
        -->
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-openid</artifactId>
            <version>${jetty.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty.ee10</groupId>
            <artifactId>jetty-ee10-servlet</artifactId>
            <version>${jetty.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-slf4j-impl</artifactId>
            <version>${jetty.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>${hamcrest.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- unmarkable.properties carries ${project.version} through to runtime so
                 the UI can show which build it is. Everything else is copied verbatim:
                 the client HTML is full of ${...}-looking JS. -->
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>unmarkable.properties</include>
                </includes>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>unmarkable.properties</exclude>
                </excludes>
                <filtering>false</filtering>
            </resource>
            <!-- ONE copy of the client. client/www is the Capacitor webDir; the same
                 files are packaged as /static/ so the browser fallback served by this
                 server is the same build the native shell wraps, not a second one. -->
            <resource>
                <directory>client/www</directory>
                <targetPath>static</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <!-- `default-cli` is the execution id `mvn exec:java` picks up when
                         invoked without an @executionId. Scoping the server launch to it
                         keeps commandlineArgs out of the js-tests execution below. -->
                    <execution>
                        <id>default-cli</id>
                        <configuration>
                            <mainClass>org.mortbay.sailing.unmarkable.server.UnmarkableServer</mainClass>
                            <commandlineArgs>${unmarkable-data}</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- The crossing detector and the geo module are JavaScript, because
                         they run on the boat. Their specs run in the Maven build so they
                         cannot rot. -->
                    <execution>
                        <id>js-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>node</executable>
                            <arguments>
                                <argument>${project.basedir}/tools/run-js-tests.mjs</argument>
                            </arguments>
                            <skip>${maven.test.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
