[Unit]
Description=unmarkable — sail racing around virtual marks
Documentation=https://github.com/gregw/unmarkable
# network-online rather than network, and with a login configured it is not merely
# preferable: the server reaches the OpenID provider during start-up to discover its
# endpoints, so starting before the Pi has a route means that lookup fails and the unit
# does not come up at all. Without a login it is the milder reason — the server binds a
# port and is useless without a route, and boats posting records are the point of it
# being up.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unmarkable
Group=unmarkable
WorkingDirectory=/opt/unmarkable
Environment=HOME=/var/lib/unmarkable
ExecStart=/usr/bin/mvn --batch-mode -Dmaven.repo.local=/var/lib/unmarkable/.m2/repository exec:java -Dunmarkable-data=/var/lib/unmarkable
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=unmarkable

NoNewPrivileges=true

# The store holds boats' own accounts of their races, which is the evidence behind
# every result. These stop a confused or compromised process writing anywhere else.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/unmarkable

[Install]
WantedBy=multi-user.target
