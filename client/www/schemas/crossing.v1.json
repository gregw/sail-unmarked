{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crossing",
  "description": "C→S. One latch. The instant is the INTERPOLATED one, which is the entire reason the detector interpolates. Advisory: the record is definitive (§8.3).",
  "type": "object",
  "properties": {
    "session": {
      "type": "string"
    },
    "line": {
      "type": "string"
    },
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "lap": {
      "type": "integer",
      "minimum": 1
    },
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string"
    },
    "confirmedFixes": {
      "type": "integer",
      "minimum": 1
    },
    "letter": {
      "type": "string"
    },
    "finish": {
      "type": "boolean"
    }
  },
  "required": [
    "session",
    "line",
    "instant"
  ]
}
